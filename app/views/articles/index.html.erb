<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Articles</h1>
    <%= link_to "New Article", new_article_path, class: "bg-gradient-to-r from-blue-500 to-indigo-500 text-white py-2 px-4 rounded-lg shadow-md hover:shadow-lg transition duration-200" %>
  </div>

  <% if @articles.any? %>
    <div class="grid gap-6">
      <% @articles.each do |article| %>
        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            <%= link_to article.title, article_path(article), class: "hover:text-blue-600 transition duration-200" %>
          </h3>
          <p class="text-gray-600 mb-4">
            <%= truncate(strip_tags(article.body), length: 150) %>
          </p>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">
              <%= article.created_at.strftime("%B %d, %Y") %>
            </span>
            <%= link_to "Read More", article_path(article), class: "text-blue-500 hover:text-blue-700 transition duration-200" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <h2 class="text-2xl font-bold text-gray-700 mb-4">No articles found</h2>
      <p class="text-gray-500">Start by creating a new article.</p>
    </div>
  <% end %>
</div>
