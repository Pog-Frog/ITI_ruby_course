<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= form_with(model: @article, local: true, class: "space-y-6") do |f| %>
    <div>
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :title, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 text-gray-900 placeholder-gray-500", placeholder: "Enter article title" %>
    </div>

    <div>
      <%= f.label :body, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :body, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 text-gray-900 placeholder-gray-500", placeholder: "Write your article content here", rows: 6 %>
    </div>

    <div>
      <%= f.label :image, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.file_field :image, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 text-gray-900" %>
    </div>

    <div>
      <%= f.submit "Save Article", class: "w-full py-3 px-4 bg-gradient-to-r from-blue-500 to-indigo-500 text-white rounded-lg shadow-md hover:shadow-lg transition duration-200" %>
    </div>
  <% end %>
</div>
