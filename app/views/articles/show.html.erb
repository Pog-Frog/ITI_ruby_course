<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white rounded-lg shadow-lg p-8 border border-gray-200">
    <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= @article.title %></h1>
    <p class="text-gray-600 mb-6">
      <%= @article.created_at.strftime("%B %d, %Y") %> by <%= @article.user.email %>
    </p>
    <div class="prose max-w-none text-gray-700 mb-6">
      <%= @article.body.html_safe %>
    </div>
    <% if @article.image.attached? %>
      <div class="mb-6">
        <%= image_tag @article.image, class: "rounded-lg shadow-md" %>
      </div>
    <% end %>
    <div class="flex justify-between items-center">
      <%= link_to "Edit Article", edit_article_path(@article), class: "bg-blue-500 text-white py-2 px-4 rounded-lg shadow-md hover:bg-blue-600 transition duration-200" if can?(:edit, @article) %>
      <%= button_to "Delete Article", article_path(@article), method: :delete, class: "bg-red-500 text-white py-2 px-4 rounded-lg shadow-md hover:bg-red-600 transition duration-200", data: { confirm: "Are you sure you want to delete this article?" } if can?(:destroy, @article) %>
    </div>
  </div>
</div>
