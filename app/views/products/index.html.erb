<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
  <!-- Header -->
  <div class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div class="flex-1 min-w-0 mb-4 md:mb-0">
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 to-purple-600">
              Products
            </span>
          </h1>
          <p class="mt-1 text-sm text-gray-500">Manage your product inventory</p>
        </div>
        <div class="flex">
          <%= link_to new_product_path, 
              class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-300 transform hover:scale-105" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Product
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="max-w-7xl mx-auto py-8 sm:px-6 lg:px-8">
    <% if @products.any? %>
      <div id="products" class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% @products.each do |product| %>
          <div class="group bg-white overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-indigo-200 transform hover:-translate-y-1">
            <div class="h-48 bg-gradient-to-br from-indigo-50 to-purple-50 flex items-center justify-center">
              <div class="w-20 h-20 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg transform group-hover:rotate-3 transition-transform duration-300">
                <svg class="h-10 w-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors duration-300">
                <%= link_to product.name, product, class: "hover:text-purple-600 focus:outline-none focus:underline transition-colors duration-300" %>
              </h3>
              
              <p class="text-sm text-gray-500 mb-4 line-clamp-2">
                Product ID: #<%= product.id %>
              </p>
              
              <div class="mt-6 flex justify-between items-center">
                <%= link_to product, 
                    class: "inline-flex items-center text-indigo-600 hover:text-indigo-500 font-medium text-sm transition-colors duration-300" do %>
                  View details
                  <svg class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                <% end %>

                <div class="flex space-x-2">
                  <%= link_to edit_product_path(product),
                      class: "p-2 rounded-full hover:bg-indigo-50 transition-colors duration-300",
                      title: "Edit" do %>
                    <svg class="h-5 w-5 text-gray-500 hover:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16 px-4">
        <div class="mx-auto h-40 w-40 text-indigo-300 opacity-60">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-full w-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <h3 class="mt-6 text-2xl font-bold text-gray-900">No products yet</h3>
        <p class="mt-3 text-base text-gray-500 max-w-md mx-auto">Get started by adding your first product to your inventory.</p>
        <div class="mt-8">
          <%= link_to new_product_path,
              class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-300 transform hover:scale-105" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Your First Product
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>