<!-- Floating Background Elements -->
<div class="fixed inset-0 overflow-hidden pointer-events-none">
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-200 rounded-full mix-blend-multiply filter blur-2xl opacity-20 animate-float"></div>
  <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-yellow-200 rounded-full mix-blend-multiply filter blur-2xl opacity-20 animate-float" style="animation-delay: 2s;"></div>
  <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-pink-200 rounded-full mix-blend-multiply filter blur-2xl opacity-20 animate-float" style="animation-delay: 4s;"></div>
</div>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 relative">
  <!-- Hero Header -->
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-indigo-600/20 via-purple-600/20 to-pink-600/20"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Breadcrumb -->
      <nav class="flex mb-8 animate-fadeIn" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 p-4 glass-effect rounded-2xl border border-white/20">
          <li class="inline-flex items-center">
            <%= link_to products_path, class: "inline-flex items-center text-sm font-medium text-gray-600 hover:text-indigo-600 transition-all duration-300 hover:scale-105" do %>
              <svg class="w-5 h-5 mr-2.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
              </svg>
              Products
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="ml-1 text-sm font-medium text-indigo-600 md:ml-2"><%= @product.name %></span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Product Header -->
      <div class="text-center mb-12 animate-fadeIn" style="animation-delay: 0.2s;">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-3xl shadow-2xl mb-8 transform hover:rotate-12 transition-all duration-500 animate-glow">
          <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 mb-6">
          <%= @product.name %>
        </h1>
        
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Explore the details and specifications of this incredible product
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex justify-center space-x-4 mb-16 animate-fadeIn" style="animation-delay: 0.4s;">
        <% if authenticated? %>
          <%= link_to edit_product_path(@product),
              class: "group relative inline-flex items-center px-8 py-4 text-lg font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-2xl hover:shadow-purple-500/25 transition-all duration-300 transform hover:scale-105 hover:-translate-y-1" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl blur-lg opacity-75 group-hover:opacity-100 transition duration-300"></div>
            <svg class="relative w-6 h-6 mr-3 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            <span class="relative">Edit Product</span>
          <% end %>

          <%= button_to @product,
              method: :delete,
              data: {
                turbo_confirm: "⚠️ Are you sure you want to delete '#{@product.name}'? This action cannot be undone and will permanently remove this product from your collection."
              },
              class: "group relative inline-flex items-center px-8 py-4 text-lg font-bold text-red-600 border-2 border-red-600 rounded-2xl hover:text-white transition-all duration-300 ease-out hover:bg-red-600 shadow-xl hover:shadow-red-500/25 transform hover:scale-105 hover:-translate-y-1" do %>
            <span class="absolute inset-0 flex items-center justify-center w-full h-full text-white duration-300 -translate-x-full bg-red-600 group-hover:translate-x-0 ease">
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Delete Forever
            </span>
            <span class="absolute flex items-center justify-center w-full h-full text-red-600 transition-all duration-300 transform group-hover:translate-x-full ease">
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Delete Product
            </span>
            <span class="relative invisible">Delete Product</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Product Details Card -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="bg-white/90 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/20 overflow-hidden animate-fadeIn" style="animation-delay: 0.6s;">
      <!-- Card Header -->
      <div class="bg-gradient-to-r from-indigo-50 via-purple-50 to-pink-50 px-8 py-8 border-b border-white/20">
        <div class="flex items-center space-x-4">
          <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg animate-glow">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-3xl font-bold text-gray-900">Product Information</h2>
            <p class="text-lg text-gray-600">Detailed specifications and metadata</p>
          </div>
        </div>
      </div>

      <!-- Card Content -->
      <div class="p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Product ID -->
          <div class="group relative bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-8 border border-indigo-100 hover:border-indigo-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-indigo-500 rounded-full flex items-center justify-center shadow-lg">
              <span class="text-white text-xs font-bold">#</span>
            </div>
            <h3 class="text-sm font-semibold text-indigo-600 uppercase tracking-wider mb-3">Product ID</h3>
            <p class="text-3xl font-black text-gray-900 mb-2">#<%= @product.id.to_s.rjust(4, '0') %></p>
            <p class="text-sm text-gray-500">Unique identifier</p>
          </div>

          <!-- Product Name -->
          <div class="group relative bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-8 border border-purple-100 hover:border-purple-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-purple-600 uppercase tracking-wider mb-3">Product Name</h3>
            <p class="text-2xl font-black text-gray-900 mb-2 break-words"><%= @product.name %></p>
            <p class="text-sm text-gray-500">Display name</p>
          </div>

          <!-- Status -->
          <div class="group relative bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-8 border border-green-100 hover:border-green-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center shadow-lg">
              <div class="w-3 h-3 bg-white rounded-full animate-pulse"></div>
            </div>
            <h3 class="text-sm font-semibold text-green-600 uppercase tracking-wider mb-3">Status</h3>
            <div class="flex items-center space-x-2 mb-2">
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
              <p class="text-2xl font-black text-gray-900">Active</p>
            </div>
            <p class="text-sm text-gray-500">Currently available</p>
          </div>

          <% if @product.respond_to?(:created_at) %>
            <!-- Created Date -->
            <div class="group relative bg-gradient-to-br from-blue-50 to-cyan-50 rounded-2xl p-8 border border-blue-100 hover:border-blue-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
              <div class="absolute -top-4 -right-4 w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center shadow-lg">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="text-sm font-semibold text-blue-600 uppercase tracking-wider mb-3">Created</h3>
              <p class="text-xl font-black text-gray-900 mb-2"><%= @product.created_at.strftime("%B %d, %Y") %></p>
              <p class="text-sm text-gray-500"><%= time_ago_in_words(@product.created_at) %> ago</p>
            </div>
          <% end %>

          <% if @product.respond_to?(:updated_at) %>
            <!-- Updated Date -->
            <div class="group relative bg-gradient-to-br from-yellow-50 to-orange-50 rounded-2xl p-8 border border-yellow-100 hover:border-yellow-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
              <div class="absolute -top-4 -right-4 w-8 h-8 bg-yellow-500 rounded-full flex items-center justify-center shadow-lg">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
              </div>
              <h3 class="text-sm font-semibold text-yellow-600 uppercase tracking-wider mb-3">Last Updated</h3>
              <p class="text-xl font-black text-gray-900 mb-2"><%= @product.updated_at.strftime("%B %d, %Y") %></p>
              <p class="text-sm text-gray-500"><%= time_ago_in_words(@product.updated_at) %> ago</p>
            </div>
          <% end %>

          <!-- Quick Actions -->
          <div class="group relative bg-gradient-to-br from-gray-50 to-slate-50 rounded-2xl p-8 border border-gray-100 hover:border-gray-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-gray-500 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wider mb-3">Quick Actions</h3>
            <div class="space-y-3">
              <% if authenticated? %>
                <%= link_to edit_product_path(@product), class: "flex items-center text-indigo-600 hover:text-indigo-800 transition-colors duration-200" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit Product
                <% end %>
              <% end %>
              <%= link_to products_path, class: "flex items-center text-gray-600 hover:text-gray-800 transition-colors duration-200" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
                </svg>
                All Products
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Footer -->
      <div class="bg-gradient-to-r from-gray-50 to-slate-50 px-8 py-6 border-t border-gray-100">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">Product Details Complete</p>
              <p class="text-xs text-gray-500">All information verified and up to date</p>
            </div>
          </div>
          
          <%= link_to products_path, 
              class: "group inline-flex items-center text-indigo-600 hover:text-indigo-800 font-semibold transition-all duration-300 hover:scale-105" do %>
            <svg class="w-5 h-5 mr-2 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
            </svg>
            Back to Collection
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>